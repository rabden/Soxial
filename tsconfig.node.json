{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./out/types/node",
    "lib": ["ES2022"],
    "noImplicitAny": false,
    "types": ["node", "electron-vite/node"],
    "paths": {
      "@main/*": ["./electron/main/*"]
    }
  },
  "include": ["electron/**/*.ts", "src/types/app-error.ts", "src/types/onboarding-events.ts", "src/types/puter-auth-events.ts", "src/features/human/types.ts"]
}
