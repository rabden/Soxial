{
  "name": "soxial",
  "productName": "Soxial",
  "version": "0.1.8",
  "description": "Soxial is an AI-powered social media manager for X and Reddit.",
  "main": "./out/main/index.js",
  "author": "Hossain Jahed <rabden@users.noreply.github.com>",
  "scripts": {
    "dev": "cross-env LOG_LEVEL=debug GDK_GL=disabled GTK_MODULES= GTK_IM_MODULE= NO_AT_BRIDGE=1 electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "electron-vite build && electron-builder --mac --x64 --arm64",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "preview": "cross-env GDK_GL=disabled GTK_MODULES= GTK_IM_MODULE= NO_AT_BRIDGE=1 electron-vite preview",
    "kill": "pkill -9 -f 'electron .' || true",
    "restart": "npm run kill && sleep 1 && npm run dev",
    "test": "vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "reset": "node reset.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.8",
    "@google/genai": "^2.10.0",
    "@heyputer/puter.js": "^2.5.4",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^7.0.15",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "katex": "^0.17.0",
    "lucide-react": "^1.21.0",
    "mime": "^4.1.0",
    "motion": "^12.41.0",
    "react-tweet": "^3.3.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "use-stick-to-bottom": "^1.1.6",
    "zhipu-ai-provider": "^0.3.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.soxial.desktop",
    "productName": "Soxial",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "references",
        "to": "references",
        "filter": [
          "**/*.md"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "resources/icons/icon.png",
      "maintainer": "Hossain Jahed <rabden@users.noreply.github.com>"
    }
  }
}
